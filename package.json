{
  "name": "@sudobility/di",
  "version": "1.5.82",
  "description": "Platform-agnostic dependency injection interfaces for React and React Native projects with platform-specific implementations",
  "type": "module",
  "main": "dist/web/index.js",
  "types": "dist/web/index.d.ts",
  "react-native": "dist/rn/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn/index.d.ts",
        "import": "./dist/rn/index.js",
        "default": "./dist/rn/index.js"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js",
        "default": "./dist/web/index.js"
      }
    },
    "./interfaces": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js",
      "default": "./dist/mocks/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./rn": {
      "types": "./dist/rn/index.d.ts",
      "import": "./dist/rn/index.js",
      "default": "./dist/rn/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/analytics.d.ts",
      "import": "./dist/analytics/analytics.js",
      "default": "./dist/analytics/analytics.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js",
      "default": "./dist/logging/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/navigation.d.ts",
      "import": "./dist/navigation/navigation.js",
      "default": "./dist/navigation/navigation.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js",
      "default": "./dist/network/index.js"
    },
    "./notification": {
      "types": "./dist/notification/notification.d.ts",
      "import": "./dist/notification/notification.js",
      "default": "./dist/notification/notification.js"
    },
    "./storage": {
      "types": "./dist/storage/storage.d.ts",
      "import": "./dist/storage/storage.js",
      "default": "./dist/storage/storage.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./info": {
      "types": "./dist/info/index.d.ts",
      "import": "./dist/info/index.js",
      "default": "./dist/info/index.js"
    },
    "./alert": {
      "types": "./dist/alert/index.d.ts",
      "import": "./dist/alert/index.js",
      "default": "./dist/alert/index.js"
    },
    "./firebase": {
      "types": "./dist/firebase/index.d.ts",
      "import": "./dist/firebase/index.js",
      "default": "./dist/firebase/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run test:unit && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "dependency-injection",
    "react",
    "react-native",
    "typescript",
    "platform-agnostic",
    "interfaces"
  ],
  "author": "johnqh",
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@react-native-firebase/analytics": "~26.4.1",
    "@react-native-firebase/app": "~26.4.1",
    "@react-native-firebase/messaging": "~26.4.1",
    "@sudobility/types": "^1.9.76",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-prettier": "~5.5.7",
    "firebase": "~12.19.0",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "peerDependencies": {
    "@notifee/react-native": ">=7.0.0",
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "@react-native-community/netinfo": ">=9.0.0",
    "@react-native-firebase/analytics": ">=18.0.0",
    "@react-native-firebase/app": ">=18.0.0",
    "@react-native-firebase/messaging": ">=18.0.0",
    "@sudobility/types": "^1.9.76",
    "firebase": ">=11.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "@notifee/react-native": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/analytics": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/di.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1"
}
